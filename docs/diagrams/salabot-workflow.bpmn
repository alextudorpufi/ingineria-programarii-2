<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Salabot" targetNamespace="https://marketplace.example/salabot">
  <bpmn:process id="Process_Salabot" name="Salabot request qualification" isExecutable="false">
    <bpmn:documentation>Proposed workflow based on docs/salabot-plan.md. Extraction includes bounded retries and at most one output repair. All operations enforce session ownership, revisions and idempotency. Unknown values remain null. Matching is deterministic and read-only. Publication requires explicit client action and the latest confirmed revision.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane_client" name="Client / Next.js">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Describe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecoveryChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Saved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Shortlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SaveEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_backend" name="Marketplace / Spring Boot">
        <bpmn:flowNodeRef>Session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Usable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Preview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Matches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoMatches</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Revalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publishable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Published</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Service needed" />
    <bpmn:userTask id="Describe" name="Describe need or answer clarification" />
    <bpmn:serviceTask id="Session" name="Check ownership / revision; save turn" />
    <bpmn:serviceTask id="Extract" name="Extract structured fields; validate output; repair once" />
    <bpmn:exclusiveGateway id="Usable" name="Usable output?" />
    <bpmn:userTask id="Recovery" name="Preserve draft; choose retry, form or save" />
    <bpmn:exclusiveGateway id="RecoveryChoice" name="Recovery choice" />
    <bpmn:endEvent id="Saved" name="Draft saved" />
    <bpmn:userTask id="Form" name="Complete or edit traditional form" />
    <bpmn:serviceTask id="Merge" name="Validate and merge fields; invalidate old confirmation / preview" />
    <bpmn:exclusiveGateway id="Complete" name="Required fields valid and complete?" />
    <bpmn:userTask id="Clarify" name="Answer template questions about gaps / conflicts" />
    <bpmn:userTask id="Review" name="Review editable summary and unknown values" />
    <bpmn:exclusiveGateway id="Approve" name="Confirm this revision?" />
    <bpmn:serviceTask id="Confirm" name="Record confirmed draft revision" />
    <bpmn:serviceTask id="Preview" name="Filter and rank eligible profiles; create read-only preview" />
    <bpmn:exclusiveGateway id="Matches" name="Any matches?" />
    <bpmn:userTask id="Shortlist" name="View shortlist with factual reasons" />
    <bpmn:userTask id="NoMatches" name="Review why no profiles qualify; keep constraints or edit" />
    <bpmn:exclusiveGateway id="Decision" name="Client action" />
    <bpmn:endEvent id="SaveEnd" name="Draft saved; no publication" />
    <bpmn:serviceTask id="Revalidate" name="Check latest confirmation, request rules and current eligibility" />
    <bpmn:exclusiveGateway id="Publishable" name="Publication valid?" />
    <bpmn:serviceTask id="Publish" name="Publish request through request module; distribute to eligible leads" />
    <bpmn:endEvent id="Published" name="Request published" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="Describe" />
    <bpmn:sequenceFlow id="F02" sourceRef="Describe" targetRef="Session" />
    <bpmn:sequenceFlow id="F03" sourceRef="Session" targetRef="Extract" />
    <bpmn:sequenceFlow id="F04" sourceRef="Extract" targetRef="Usable" />
    <bpmn:sequenceFlow id="F05" sourceRef="Usable" targetRef="Recovery" name="No / provider failure" />
    <bpmn:sequenceFlow id="F06" sourceRef="Recovery" targetRef="RecoveryChoice" />
    <bpmn:sequenceFlow id="F07" sourceRef="RecoveryChoice" targetRef="Extract" name="Retry" />
    <bpmn:sequenceFlow id="F08" sourceRef="RecoveryChoice" targetRef="Form" name="Form" />
    <bpmn:sequenceFlow id="F09" sourceRef="RecoveryChoice" targetRef="Saved" name="Save / exit" />
    <bpmn:sequenceFlow id="F10" sourceRef="Usable" targetRef="Merge" name="Yes" />
    <bpmn:sequenceFlow id="F11" sourceRef="Form" targetRef="Merge" />
    <bpmn:sequenceFlow id="F12" sourceRef="Merge" targetRef="Complete" />
    <bpmn:sequenceFlow id="F13" sourceRef="Complete" targetRef="Clarify" name="No" />
    <bpmn:sequenceFlow id="F14" sourceRef="Clarify" targetRef="Describe" name="Next turn" />
    <bpmn:sequenceFlow id="F15" sourceRef="Complete" targetRef="Review" name="Yes" />
    <bpmn:sequenceFlow id="F16" sourceRef="Review" targetRef="Approve" />
    <bpmn:sequenceFlow id="F17" sourceRef="Approve" targetRef="Form" name="Edit" />
    <bpmn:sequenceFlow id="F18" sourceRef="Approve" targetRef="Confirm" name="Confirm" />
    <bpmn:sequenceFlow id="F19" sourceRef="Confirm" targetRef="Preview" />
    <bpmn:sequenceFlow id="F20" sourceRef="Preview" targetRef="Matches" />
    <bpmn:sequenceFlow id="F21" sourceRef="Matches" targetRef="Shortlist" name="Yes" />
    <bpmn:sequenceFlow id="F22" sourceRef="Matches" targetRef="NoMatches" name="No" />
    <bpmn:sequenceFlow id="F23" sourceRef="Shortlist" targetRef="Decision" />
    <bpmn:sequenceFlow id="F24" sourceRef="NoMatches" targetRef="Decision" />
    <bpmn:sequenceFlow id="F25" sourceRef="Decision" targetRef="Form" name="Edit constraints" />
    <bpmn:sequenceFlow id="F26" sourceRef="Decision" targetRef="SaveEnd" name="Save / exit" />
    <bpmn:sequenceFlow id="F27" sourceRef="Decision" targetRef="Revalidate" name="Explicitly publish" />
    <bpmn:sequenceFlow id="F28" sourceRef="Revalidate" targetRef="Publishable" />
    <bpmn:sequenceFlow id="F29" sourceRef="Publishable" targetRef="Review" name="No: resolve / reconfirm" />
    <bpmn:sequenceFlow id="F30" sourceRef="Publishable" targetRef="Publish" name="Yes" />
    <bpmn:sequenceFlow id="F31" sourceRef="Publish" targetRef="Published" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Marketplace" name="Salabot — proposed AI-assisted request workflow" processRef="Process_Salabot" />
    <bpmn:participant id="Provider" name="External LLM provider" />
    <bpmn:messageFlow id="M01" sourceRef="Extract" targetRef="Provider" name="Minimized context + schema" />
    <bpmn:messageFlow id="M02" sourceRef="Provider" targetRef="Extract" name="Candidate fields / failure" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
