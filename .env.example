# Copy this file to .env and replace every "changeme" value.
# Never commit real credentials. See docs/security/vulnerability-fix-plan.md.

# Application Database Configuration
DB_NAME=marketplace
DB_USER=marketplace
DB_PASSWORD=changeme
DB_PORT=5432

# JWT signing key — generate with: openssl rand -hex 48
# Must be at least 32 bytes; required in every profile. Placeholder values are rejected.
JWT_SECRET=
JWT_ISSUER=marketplace-backend
JWT_AUDIENCE=marketplace-api
JWT_TOKEN_VERSION=1

# Browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Stripe test mode (never use live keys in local development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# SonarQube Configuration
SONAR_PORT=9000
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=changeme
SONAR_ADMIN_USER=admin
SONAR_ADMIN_PASSWORD=changeme
# Optional: generate a token in SonarQube UI (Security > Tokens) and paste here
SONAR_TOKEN=
